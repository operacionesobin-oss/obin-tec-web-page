# Reglas para Hostinger (Apache / LiteSpeed).
# Sustituyen al middleware de Next, que no existe en un export estático.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── HTTPS ────────────────────────────────────────────────────────────────
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Idioma ───────────────────────────────────────────────────────────────
  # La raíz va al idioma que pide el navegador. 302 y no 301: la preferencia
  # depende del visitante, así que no debe quedar cacheada como permanente.
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [L,R=302]
  RewriteRule ^$ /es/ [L,R=302]

  # Cualquier ruta sin locale (/servicios) va al español, salvo que sea un
  # fichero real, un directorio, un recurso de Next o algo con extensión
  # (sitemap.xml, robots.txt). Reproduce el matcher del middleware anterior.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/(es|en)(/|$)
  RewriteCond %{REQUEST_URI} !^/_next/
  RewriteCond %{REQUEST_URI} !\.
  # El patrón absorbe la barra final para volver a añadirla: así /servicios
  # salta directo a /es/servicios/ en vez de encadenar dos redirecciones.
  RewriteRule ^(.*?)/?$ /es/$1/ [L,R=302]
</IfModule>

ErrorDocument 404 /404.html

# ── Caché ──────────────────────────────────────────────────────────────────
# Los assets de /_next/static llevan hash en el nombre: son inmutables.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # El HTML no se cachea: es lo que cambia al publicar.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Sin listados de directorio.
Options -Indexes
